{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news-intel.local/schemas/crime-post.v2.schema.json",
  "title": "Published crime post v2 (additive)",
  "type": "object",
  "required": ["id", "title", "content", "format_version"],
  "properties": {
    "format_version": { "const": 2 },
    "content": { "type": "string", "description": "สรุปข่าวเดิม คงไว้ด้านบน" },
    "exec_blurb": { "type": "string" },
    "analysis_notes": { "type": "string" },
    "primary_bureau": { "type": "string" },
    "area": { "type": "string" },
    "status_th": { "type": "string" },
    "gang_or_group": { "type": "string" },
    "related_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relation"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "relation": { "type": "string" }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
