{
  "mcpServers": {
    "news-hub": {
      "command": "node",
      "args": ["${NEWSINTEL_HOME}/server/dist/mcp-stdio.js"],
      "env": {
        "NEWSINTEL_HOME": "${NEWSINTEL_HOME}",
        "DB_PATH": "${NEWSINTEL_HOME}/server/data/newshub.sqlite",
        "EXPORT_PATH": "${NEWSINTEL_HOME}/server/exports",
        "NEWSHUB_URL": "${NEWSHUB_URL}",
        "NEWSHUB_TOKEN": "${NEWSHUB_TOKEN}"
      }
    }
  }
}
