PORT=8080
TZ=Asia/Bangkok
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Absolute paths recommended on the always-on host
NEWSINTEL_HOME=.
DB_PATH=./data/newshub.sqlite
EXPORT_PATH=./exports
# One rolling workbook: URLs + uploads only (plain chat text never stored)
CONTINUOUS_XLSX_PATH=./exports/line_intake_continuous.xlsx
CONTINUOUS_JSON_PATH=./exports/line_intake_continuous.json
VAULT_PATH=./vault
BACKUP_PATH=./backup
RETENTION_LINKS_DAYS=30

# LINE Messaging API
LINE_CHANNEL_SECRET=replace_me
# Long-lived channel access token (Messaging API tab). Needed to download
# file/image/video/audio. URL-only intake still works without it.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_FILES_PATH=./data/line-files
LINE_FILE_MAX_BYTES=20000000
# Comma-separated groupIds that may post links (required in production)
LINE_ALLOWED_GROUP_IDS=Cxxxxxxxx
# Optional aliases: groupId=alias
LINE_GROUP_ALIASES=Cxxxxxxxx=crime-desk

# Optional reserved ngrok free hostname (stable URL). Leave empty for ephemeral.
# Example: news-hub.ngrok-free.app
NGROK_DOMAIN=

# API / MCP bearer tokens
API_TOKEN_CLAUDE=change-me-claude
API_TOKEN_READONLY=change-me-readonly
NEWSHUB_URL=http://127.0.0.1:18080

# Optional public site base for Completion Report links (no trailing slash)
# Example: https://chiraleo2000.github.io/police-news-intel-kit
# Local preview: leave empty and use `npx serve github-pages` then open /#/YYYY-MM-DD
GITHUB_PAGES_BASE_URL=https://chiraleo2000.github.io/Police-news-intel-kit
