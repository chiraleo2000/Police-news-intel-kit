{
  "name": "news-hub",
  "version": "0.2.0",
  "private": true,
  "description": "news-hub: LINE webhook → SQLite → export Excel/JSON + MCP for Claude schedules",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp-stdio.js",
    "job:export-links": "tsx src/jobs/export-links.ts",
    "job:vault-build": "tsx src/jobs/vault-build.ts",
    "job:healthcheck": "tsx src/jobs/healthcheck.ts",
    "job:backup": "tsx src/jobs/backup.ts",
    "test:url": "tsx src/line/url.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.9.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
