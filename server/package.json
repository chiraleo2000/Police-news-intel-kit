{
  "name": "news-hub",
  "version": "0.1.0",
  "private": true,
  "description": "news-hub: LINE webhook + SQLite state + MCP stdio shim (skeleton)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp-stdio.js",
    "job:export-links": "node dist/jobs/export-links.js",
    "job:vault-build": "node dist/jobs/vault-build.js",
    "job:healthcheck": "node dist/jobs/healthcheck.js",
    "job:backup": "node dist/jobs/backup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.9.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
